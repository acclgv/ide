{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Hanzo file system and core permissions",
  "windows": ["main", "hanzo-chat-detached", "hanzo-*"],
  "local": true,
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://localhost:*/*",
      "http://localhost:*#*",
      "http://localhost:*/*#*",
      "http://localhost:*?*",
      "http://localhost:*/*?*",
      "http://localhost:*?*#*",
      "http://localhost:*/*?*#*",
      "http://127.0.0.1:*",
      "http://127.0.0.1:*/*",
      "http://127.0.0.1:*#*",
      "http://127.0.0.1:*/*#*",
      "http://127.0.0.1:*?*",
      "http://127.0.0.1:*/*?*",
      "http://127.0.0.1:*?*#*",
      "http://127.0.0.1:*/*?*#*"
    ]
  },
  "permissions": [
    "allow-hanzo-ide-commands",
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-center",
    "fs:default",
    "fs:scope-home-recursive",
    "fs:scope-desktop-recursive",
    "fs:scope-download-recursive",
    "fs:scope-document-recursive",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.*" },
        { "path": "$HOME/**/.*/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DESKTOP/**/.*" },
        { "path": "$DESKTOP/**/.*/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOCUMENT/**/.*" },
        { "path": "$DOCUMENT/**/.*/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOWNLOAD/**/.*" },
        { "path": "$DOWNLOAD/**/.*/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.*" },
        { "path": "$HOME/**/.*/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DESKTOP/**/.*" },
        { "path": "$DESKTOP/**/.*/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOCUMENT/**/.*" },
        { "path": "$DOCUMENT/**/.*/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOWNLOAD/**/.*" },
        { "path": "$DOWNLOAD/**/.*/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.*" },
        { "path": "$HOME/**/.*/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DESKTOP/**/.*" },
        { "path": "$DESKTOP/**/.*/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOCUMENT/**/.*" },
        { "path": "$DOCUMENT/**/.*/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOWNLOAD/**/.*" },
        { "path": "$DOWNLOAD/**/.*/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.*" },
        { "path": "$HOME/**/.*/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DESKTOP/**/.*" },
        { "path": "$DESKTOP/**/.*/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOCUMENT/**/.*" },
        { "path": "$DOCUMENT/**/.*/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOWNLOAD/**/.*" },
        { "path": "$DOWNLOAD/**/.*/**" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.*" },
        { "path": "$HOME/**/.*/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DESKTOP/**/.*" },
        { "path": "$DESKTOP/**/.*/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOCUMENT/**/.*" },
        { "path": "$DOCUMENT/**/.*/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOWNLOAD/**/.*" },
        { "path": "$DOWNLOAD/**/.*/**" }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.*" },
        { "path": "$HOME/**/.*/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DESKTOP/**/.*" },
        { "path": "$DESKTOP/**/.*/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOCUMENT/**/.*" },
        { "path": "$DOCUMENT/**/.*/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOWNLOAD/**/.*" },
        { "path": "$DOWNLOAD/**/.*/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.*" },
        { "path": "$HOME/**/.*/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DESKTOP/**/.*" },
        { "path": "$DESKTOP/**/.*/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOCUMENT/**/.*" },
        { "path": "$DOCUMENT/**/.*/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOWNLOAD/**/.*" },
        { "path": "$DOWNLOAD/**/.*/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.*" },
        { "path": "$HOME/**/.*/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DESKTOP/**/.*" },
        { "path": "$DESKTOP/**/.*/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOCUMENT/**/.*" },
        { "path": "$DOCUMENT/**/.*/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOWNLOAD/**/.*" },
        { "path": "$DOWNLOAD/**/.*/**" }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.*" },
        { "path": "$HOME/**/.*/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DESKTOP/**/.*" },
        { "path": "$DESKTOP/**/.*/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOCUMENT/**/.*" },
        { "path": "$DOCUMENT/**/.*/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOWNLOAD/**/.*" },
        { "path": "$DOWNLOAD/**/.*/**" }
      ]
    },
    {
      "identifier": "fs:allow-lstat",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.*" },
        { "path": "$HOME/**/.*/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DESKTOP/**/.*" },
        { "path": "$DESKTOP/**/.*/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOCUMENT/**/.*" },
        { "path": "$DOCUMENT/**/.*/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOWNLOAD/**/.*" },
        { "path": "$DOWNLOAD/**/.*/**" }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "shell:default",
    "shell:allow-open"
  ]
}
